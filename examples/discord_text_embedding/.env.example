COCOINDEX_DB=./cocoindex.db

# discord_text_embedding — environment template.
# Copy to .env (auto-loaded when you run the example): cp .env.example .env

# Postgres + pgvector target. Start a local one: docker compose -f ../../dev/postgres.yaml up -d
POSTGRES_URL=postgres://cocoindex:cocoindex@localhost/cocoindex

# The bot's token (secret): Developer Portal > your app > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# The channels to index: one or more channel IDs, comma-separated, in any order.
# Each can be a forum, text or announcement channel. Removing an ID removes that
# channel's rows on the next run.
DISCORD_CHANNEL_IDS=

# Only for seed_server.py: a webhook in each channel to fill; leave out any
# (secret: anyone with a webhook's URL can post through it).
DISCORD_SEED_FORUM_WEBHOOK_URL=
DISCORD_SEED_TEXT_WEBHOOK_URL=
DISCORD_SEED_ANNOUNCEMENT_WEBHOOK_URL=

# Fallback to CPU for operations not supported by MPS on Mac.
# It's no-op for other platforms.
PYTORCH_ENABLE_MPS_FALLBACK=1
