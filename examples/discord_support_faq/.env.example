COCOINDEX_DB=./cocoindex.db

# discord_support_faq — environment template.
# Copy to .env (auto-loaded when you run the example): cp .env.example .env

# LLM models (LiteLLM-prefixed; e.g. openai/gpt-5-mini, or ollama/llama3.2 to run
# locally without a key). LLM_MODEL reads each thread; RESOLUTION_LLM_MODEL
# decides whether two similar questions are the same one.
LLM_MODEL=openai/gpt-5-mini
RESOLUTION_LLM_MODEL=openai/gpt-5-mini
# For OpenAI models (secret).
OPENAI_API_KEY=

# The bot's token (secret): Developer Portal > your app > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# The channels to read: one or more channel IDs, comma-separated, in any order.
# Each can be a forum, text or announcement channel; only their threads are read.
DISCORD_CHANNEL_IDS=

# Only for seed_server.py: a webhook in the forum to fill (secret: anyone with
# its URL can post through it).
DISCORD_SEED_WEBHOOK_URL=

# Fallback to CPU for operations not supported by MPS on Mac.
# It's no-op for other platforms.
PYTORCH_ENABLE_MPS_FALLBACK=1
