KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Obtain this from your broker before the first update; it is not a secret.
KAFKA_CLUSTER_ID=replace-with-the-broker-cluster-id
KAFKA_TOPIC=cocoindex-faststream
# Stable logical identity, retained in the CocoIndex state store.
KAFKA_DESTINATION=faststream-example-local
METRICS_PORT=8001
