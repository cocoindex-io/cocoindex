COCOINDEX_DB=./cocoindex.db

# multi_source_knowledge_graph — environment template.
# Copy to .env (auto-loaded when you run the example): cp .env.example .env

# Postgres holding the component catalog table (seeded by prepare_source_data.sql).
# Start a local one: docker compose -f ../../dev/postgres.yaml up -d
POSTGRES_URL=postgres://cocoindex:cocoindex@localhost/cocoindex

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cocoindex
NEO4J_DATABASE=neo4j

# Folder of Markdown / MDX docs. Defaults to this repository's own docs.
DOCS_DIR=../../docs/src/content/docs

# GitHub repo whose issues feed the graph. Unauthenticated search allows ten
# requests a minute, enough for the 1,000-issue search cap; set GITHUB_TOKEN to
# raise the limit. For GitHub Enterprise, point GITHUB_API_URL at
# https://<your-host>/api/v3.
GITHUB_REPO=cocoindex-io/cocoindex
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_MAX_ISSUES=1000
