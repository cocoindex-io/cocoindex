# CocoIndex keeps its incremental state in this local file.
COCOINDEX_DB=./cocoindex.db

# Qdrant vector store. Start one: docker run -d -p 6333:6333 -p 6334:6334 qdrant/qdrant
QDRANT_URL=http://localhost:6334/

# Fallback to CPU for operations not supported by MPS on Mac. No-op elsewhere.
PYTORCH_ENABLE_MPS_FALLBACK=1
