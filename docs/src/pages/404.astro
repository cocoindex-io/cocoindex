---
// Docs 404: one left-aligned column with the search button and the pages a
// lost reader most likely wanted. Styles: src/styles/site.css §12.
import '../styles/globals.css';
import Topbar from '../components/Topbar.astro';
import MobileSheet from '../components/MobileSheet.astro';
import Search from '../components/Search.astro';
import { THEME_COLOR, SITE_BLOG, SITE_EXAMPLES } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const doc = (slug: string) => `${base}/${slug}/`;
const places = [
  { href: doc('getting_started/quickstart'), label: 'Quickstart', note: 'First pipeline in 5 minutes' },
  { href: doc('programming_guide/core_concepts'), label: 'Core concepts', note: 'The model behind the engine' },
  { href: doc('connectors'), label: 'Connectors', note: 'Sources and targets' },
  { href: doc('cli'), label: 'CLI reference', note: 'cocoindex update, show, drop' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not found · CocoIndex Docs</title>
    <meta name="description" content="This docs page does not exist. Search the docs or start from the quickstart." />
    <link rel="icon" href={`${base}/img/favicon.ico`} />
  </head>
  <body>
    <Topbar mobileSheetId="mobileSheet" />
    <MobileSheet />
    <main class="nf">
      <div class="nf-wrap">
        <p class="nf-code">404</p>
        <h1 class="nf-title">Page not found</h1>
        <p class="nf-lead">
          No docs page lives at this address. It may have moved with the v1 rewrite, or the
          link may carry a typo.
        </p>
        <div class="nf-search"><Search /></div>
        <div class="nf-ctas">
          <a href={`${base}/`} class="btn btn-primary btn-lg">Docs home</a>
          <a href={SITE_EXAMPLES} class="btn btn-outline-muted btn-lg">Examples</a>
          <a href={SITE_BLOG} class="btn btn-outline-muted btn-lg">Blog</a>
        </div>
        <ul class="nf-list">
          {places.map((p) => (
            <li><a href={p.href}>{p.label}<span>{p.note}</span></a></li>
          ))}
        </ul>
      </div>
    </main>
  </body>
</html>
