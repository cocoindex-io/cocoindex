---
import { render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import LangLink from '../components/LangLink.astro';
import Lang from '../components/Lang.astro';
import LangTabs from '../components/LangTabs.astro';
import RustNote from '../components/RustNote.astro';
import LangCardGrid from '../components/LangCardGrid.astro';
import { titleText } from '../consts';
import { docStaticPaths } from '../lib/raw-markdown';
import { headingsFor, pageEntry, type Lang } from '../lib/lang';

export const getStaticPaths = docStaticPaths;

type Props = { doc: CollectionEntry<'docs'>; lang: Lang; route: string };
const { doc, lang, route } = Astro.props as Props;
// Components inside the page body (Lang, LangTabs, RustNote, LangLink) read
// the page's language from here; see src/lib/lang.ts currentLang().
(Astro.locals as { lang?: Lang }).lang = lang;

const { Content, headings: mdHeadings } = await render(doc);
const headings = headingsFor(mdHeadings, doc.body ?? '', lang);

const rel = (doc as unknown as { filePath?: string }).filePath
  ?.split('src/content/docs/')
  .pop();
const sourcePath = `src/content/docs/${rel ?? `${doc.id}.md`}`;

// Title may contain *asterisks* marking coral accent segments
// (see src/consts.ts titleMarkup); plain metadata strips them. A Rust page
// may override both with `rust_title` / `rust_description`.
const data = doc.data as Record<string, unknown>;
const pick = (key: 'title' | 'description'): string | undefined => {
  const own = lang === 'rust' ? data[`rust_${key}`] : undefined;
  const v = typeof own === 'string' && own.length > 0 ? own : data[key];
  return typeof v === 'string' && v.length > 0 ? v : undefined;
};
const rawTitle = pick('title') ?? route;
const metaTitle = titleText(rawTitle);
const description = pick('description');
const introMeta = doc.data.meta;
const { neutral } = pageEntry(doc);
---

<DocsLayout
  title={metaTitle}
  titleMarkup={rawTitle}
  description={description}
  slug={route}
  lang={lang}
  neutral={neutral}
  headings={headings}
  sourcePath={sourcePath}
  introMeta={introMeta}
>
  {/* Lang, LangTabs, RustNote and LangCardGrid need no import in a page. */}
  <Content components={{ a: LangLink, Lang, LangTabs, RustNote, LangCardGrid }} />
</DocsLayout>
