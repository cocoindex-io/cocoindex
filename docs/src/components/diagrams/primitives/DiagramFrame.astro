---
import '../diagrams.css';

interface Props {
  viewBox: string;
  title?: string;
  desc?: string;
  class?: string;
  maxWidth?: number;
}
const {
  viewBox,
  title,
  desc,
  class: extraClass = '',
  maxWidth,
} = Astro.props;

// SVG IDs belong to the document. Scope them when one page contains several diagrams.
const scope = `dg-${crypto.randomUUID().slice(0, 8)}`;
const content = (await Astro.slots.render('default')).replaceAll('url(#dg-arrow', `url(#${scope}-arrow`);
// Every current consumer composes fixed SVG coordinates; labels cannot reflow the diagram.
const intrinsicWidth = Number(viewBox.trim().split(/[\s,]+/)[2]);
const wrapperStyle = `--dg-max-width: ${maxWidth ?? 720}px; --diagram-readable-width: ${intrinsicWidth}px;`;
---

<figure class="dg-figure" style={wrapperStyle}>
<div
  class="diagram-scroll"
  role="region"
  aria-label={title ? `${title} diagram` : 'Diagram'}
  aria-describedby={`${scope}-scroll-hint`}
  tabindex="0"
  data-diagram-scroll
>
<svg
  class={`dg-root ${extraClass}`.trim()}
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby={title ? `${scope}-title` : undefined}
  aria-describedby={desc ? `${scope}-desc` : undefined}
>
  {title && <title id={`${scope}-title`}>{title}</title>}
  {desc && <desc id={`${scope}-desc`}>{desc}</desc>}
  <defs>
    <marker
      id={`${scope}-arrow`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
    </marker>
    <marker
      id={`${scope}-arrow-coral`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--muted)" />
    </marker>
    <marker
      id={`${scope}-arrow-palm`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--palm)" />
    </marker>
    <marker
      id={`${scope}-arrow-muted`}
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill="var(--rule-strong, rgba(42,18,27,0.35))" />
    </marker>
  </defs>
  <Fragment set:html={content} />
</svg>

</div>
<figcaption class="diagram-scroll-hint" id={`${scope}-scroll-hint`}>
  Scroll horizontally to explore the diagram. Use arrow keys when focused.
</figcaption>
</figure>

<script>
  import { makeDiagramScrollable } from '../../../lib/readable-diagrams';

  document.querySelectorAll<HTMLElement>('[data-diagram-scroll]').forEach((region) => {
    const hint = document.getElementById(region.getAttribute('aria-describedby')!);
    if (hint) makeDiagramScrollable(region, hint);
  });
</script>
