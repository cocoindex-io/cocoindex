---
// Semantic search over Discord: the three channels seed_server.py fills (six
// forum posts, a chat in a text channel, two rich-embed announcements), one
// item per post or message, chunked and embedded into
// coco_examples_v1.discord_embeddings (ChunkEmbedding: id, url, title, text,
// embedding), then the README's two queries with the result the hand run
// ranked first for each. The replied-to post (Δ) is the README's first
// "See it update" step: only that post is embedded again. URLs keep their
// shape (guild / thread, or guild / channel / message) with the IDs elided
// rather than invented; ids come from IdGenerator and are elided too.
interface Props { size?: 'hero' | 'card' }
const { size = 'hero' } = Astro.props;
---
{size === 'hero' ? (
  <div class="dc">
    <div class="sc-row">
      <div class="sc-col dc-src">
        <span class="sc-cap">Discord channels</span>
        <div class="sc-panel">
          <div class="sc-panel-h"><span class="sc-ico i-stream"></span>DISCORD_CHANNEL_IDS</div>
          <div class="sc-panel-b">
            <span class="dc-grp">Forum · a DiscordThread per post</span>
            <div class="sc-li sc-delta"><span class="sc-ico i-file"></span><span>Sync stops after my laptop wakes from sleep</span><span class="sc-dmark">Δ</span></div>
            <div class="sc-li"><span class="sc-ico i-file"></span><span>Exported PDF cuts off long code blocks</span></div>
            <div class="sc-li"><span class="sc-ico i-file"></span><span>Can I host the sync server myself?</span></div>
            <span class="dc-more">+3 more posts</span>
            <span class="dc-grp">Text · a DiscordMessage per message</span>
            <div class="sc-li"><span class="sc-ico i-person"></span><span>chen: I start each meeting from a template…</span></div>
            <span class="dc-grp">Announcements · rich embeds</span>
            <div class="sc-li"><span class="sc-ico i-person"></span><span>status-bot: Scheduled maintenance</span></div>
          </div>
        </div>
        <p class="sc-quote dc-note">A reply re-embeds only its post. A reaction, a pin or a join re-embeds nothing.</p>
      </div>
      <span class="sc-to"></span>
      <div class="sc-col">
        <span class="sc-cap">Chunk and embed</span>
        <div class="sc-panel"><div class="sc-panel-b">
          <span class="sc-li"><span class="sc-ico i-code"></span><span>item.read_text()</span></span>
          <p class="sc-quote sc-clip3 dc-chunk"><b>Sync stops after my laptop wakes from sleep</b><br />ada: Every morning my notes stop syncing until I quit and reopen the app…</p>
          <span class="sc-li"><span class="sc-ico i-code"></span><span>RecursiveSplitter</span></span>
          <span class="sc-li"><span class="sc-ico i-model"></span><span>all-MiniLM-L6-v2</span></span>
        </div></div>
        <span class="sc-cap dc-fine">2000-char chunks, 500 overlap</span>
      </div>
      <span class="sc-to"></span>
      <div class="sc-col dc-wide">
        <span class="sc-cap">Postgres + pgvector</span>
        <div class="sc-panel">
          <div class="sc-panel-h"><span class="sc-ico i-table"></span>discord_embeddings</div>
          <table class="sc-table">
            <thead><tr><th>title</th><th class="dc-url">url</th></tr></thead>
            <tbody>
              <tr class="sc-delta"><td><span class="sc-dtext">Sync stops after my laptop…</span></td><td class="dc-url"><span class="sc-dtext">…/channels/…/…</span></td></tr>
              <tr><td>Exported PDF cuts off…</td><td class="sc-dim dc-url">…/channels/…/…</td></tr>
              <tr><td class="sc-dim">""</td><td class="sc-dim dc-url">…/channels/…/…/…</td></tr>
            </tbody>
          </table>
        </div>
        <span class="sc-cap dc-fine">A message has no title; its url names the message</span>
      </div>
    </div>

    <div class="dc-search">
      <span class="sc-cap">Search the server by meaning</span>
      <div class="sc-row dc-qs">
        <div class="sc-col">
          <div class="sc-query"><span class="sc-ico i-search"></span><span>python main.py "notes stop syncing in the morning"</span></div>
          <div class="sc-hit"><span class="r">1</span><span><span class="src">Sync stops after my laptop wakes from sleep</span><span class="sc-quote sc-clip2">Sync stops after my laptop wakes from sleep<br />ada: Every morning my notes stop syncing until I quit and reopen the app.</span></span></div>
        </div>
        <div class="sc-col">
          <div class="sc-query"><span class="sc-ico i-search"></span><span>python main.py "is sync down for maintenance?"</span></div>
          <div class="sc-hit"><span class="r">1</span><span><span class="src">discord.com/channels/…/…/…</span><span class="sc-quote sc-clip2">status-bot: Scheduled maintenance<br />Sync will be paused for about 30 minutes while we upgrade the database.</span></span></div>
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="dc-card">
    <div class="sc-row sc-keep">
      <div class="sc-panel dc-card-src">
        <div class="sc-panel-h"><span class="sc-ico i-stream"></span>Discord forum</div>
        <div class="sc-panel-b">
          <div class="sc-li sc-delta"><span class="sc-ico i-file"></span><span>Sync stops after my laptop…</span></div>
          <div class="sc-li"><span class="sc-ico i-file"></span><span>Exported PDF cuts off…</span></div>
          <div class="sc-li"><span class="sc-ico i-file"></span><span>Dark mode on the phone app?</span></div>
        </div>
      </div>
      <span class="sc-to"></span>
      <div class="sc-col">
        <div class="sc-query"><span class="sc-ico i-search"></span><span>"notes stop syncing in the morning"</span></div>
        <div class="sc-panel"><div class="sc-panel-b">
          <span class="sc-li"><span>Sync stops after my laptop…</span></span>
          <span class="sc-quote sc-clip2">ada: Every morning my notes stop syncing…</span>
        </div></div>
      </div>
    </div>
  </div>
)}

<style>
  .dc { display: flex; flex-direction: column; gap: 18px; }
  .dc > .sc-row { gap: 10px; }
  .dc-src { flex: 1.3 1 0; }
  .dc-wide { flex: 1.15 1 0; }
  .dc .sc-li { font-size: 12px; }
  .dc-src .sc-li > span:nth-child(2) { font-family: var(--sans); }
  .dc-grp { margin-top: 4px; font-size: 11.5px; font-weight: 500; color: var(--sc-dim); }
  .dc-grp:first-child { margin-top: 0; }
  .dc-more { padding-left: 22px; font-size: 12px; color: var(--sc-dim); }
  .dc-note { margin: 0; font-size: 12px; color: var(--sc-dim); }
  .dc-chunk { margin: 2px 0; }
  .dc-fine { font-weight: 400; }
  .dc-url { width: 46%; }
  .dc-search { display: flex; flex-direction: column; gap: 8px; padding-top: 16px; border-top: 1px solid var(--sc-line); }
  .dc-qs { gap: 16px; }
  .dc-qs .sc-hit { border-top: 0; }

  .dc-card { height: 100%; display: flex; align-items: center; min-width: 0; contain: inline-size; }
  .dc-card > .sc-row { width: 100%; min-width: 0; align-items: center; }
  .dc-card-src { flex: 1.1 1 0; }
  .dc-card .sc-li > span:nth-child(2) { font-family: var(--sans); }
  .dc-card .sc-query { align-items: flex-start; }
  .dc-card .sc-query > span:last-child { white-space: normal; }
</style>
