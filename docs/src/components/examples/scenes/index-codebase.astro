---
// Index your codebase: the CocoIndex repo itself (the example indexes from the
// repo root), split along the syntax tree by RecursiveSplitter with
// detect_code_language, one code_embeddings row per chunk, then the README's
// query. Chunk ranges are real: RecursiveSplitter on examples/code_embedding/
// main.py and rust/ops_text/src/split/recursive.rs with the example's settings
// (chunk_size=1000, min_chunk_size=300, chunk_overlap=300). The edited
// function is process_file (Δ): only its chunk, L91–L106, re-embeds.
interface Props { size?: 'hero' | 'card' }
const { size = 'hero' } = Astro.props;
---
{size === 'hero' ? (
  <div class="ic">
    <div class="sc-row ic-top">
      <div class="sc-col ic-repo">
        <span class="sc-cap">Your repo</span>
        <div class="sc-panel">
          <div class="sc-panel-h"><span class="sc-ico i-folder"></span>cocoindex/</div>
          <div class="sc-panel-b ic-tree">
            <div class="sc-li ic-dir"><span class="sc-ico i-folder"></span><span>examples/code_embedding/</span></div>
            <div class="sc-li ic-in sc-delta"><span class="sc-ico i-code"></span><span>main.py</span><span class="sc-dmark">Δ</span></div>
            <div class="sc-li ic-dir"><span class="sc-ico i-folder"></span><span>python/cocoindex/ops/</span></div>
            <div class="sc-li ic-in"><span class="sc-ico i-code"></span><span>text.py</span></div>
            <div class="sc-li ic-dir"><span class="sc-ico i-folder"></span><span>rust/ops_text/src/split/</span></div>
            <div class="sc-li ic-in"><span class="sc-ico i-code"></span><span>recursive.rs</span></div>
            <div class="sc-li"><span class="sc-ico i-file"></span><span>README.md</span></div>
          </div>
        </div>
        <span class="sc-cap ic-fine">*.py *.rs *.toml *.md *.mdx</span>
        <span class="sc-live">cocoindex update -L main</span>
      </div>
      <span class="sc-to"></span>
      <div class="sc-col ic-split">
        <span class="sc-cap">Split on the syntax tree</span>
        <div class="sc-panel">
          <div class="sc-panel-h"><span class="sc-ico i-code"></span>main.py<span class="ic-lang">Tree-sitter · python</span></div>
          <div class="ic-code">
            <div class="ic-chunk">
              <span class="ic-tag">L61–L88</span>
              <div class="ic-ln"><i>61</i><code><span class="f">@coco.lifespan</span></code></div>
              <div class="ic-ln"><i>62</i><code><span class="k">async def</span> <span class="f">coco_lifespan</span>(</code></div>
              <div class="ic-ln ic-gap"><i></i><code>⋯</code></div>
              <div class="ic-ln"><i>71</i><code><span class="f">@coco.fn</span></code></div>
              <div class="ic-ln"><i>72</i><code><span class="k">async def</span> <span class="f">process_chunk</span>(</code></div>
              <div class="ic-ln"><i>78</i><code>    embedding = <span class="k">await</span> coco.use_context(EMBEDDER).embed(chunk.text)</code></div>
              <div class="ic-ln"><i>79</i><code>    table.declare_row(</code></div>
            </div>
            <div class="ic-chunk is-delta">
              <span class="ic-tag">L91–L106</span>
              <div class="ic-ln"><i>91</i><code><span class="f">@coco.fn</span>(memo=<span class="n">True</span>)</code></div>
              <div class="ic-ln"><i>92</i><code><span class="k">async def</span> <span class="f">process_file</span>(</code></div>
              <div class="ic-ln"><i>97</i><code>    language = detect_code_language(filename=…)</code></div>
              <div class="ic-ln"><i>98</i><code>    chunks = _splitter.split(</code></div>
            </div>
          </div>
        </div>
        <span class="sc-cap ic-fine">Edit one function and only its chunk re-embeds.</span>
      </div>
    </div>

    <div class="sc-col">
      <span class="sc-cap">Postgres + pgvector</span>
      <div class="sc-panel">
        <div class="sc-panel-h ic-tbl-h"><span class="sc-ico i-table"></span>code_embeddings<span class="ic-lang">all-MiniLM-L6-v2</span></div>
        <table class="sc-table">
          <thead><tr><th>filename</th><th class="ic-n">start_line</th><th class="ic-n">end_line</th><th class="ic-v sc-hide-narrow">embedding</th></tr></thead>
          <tbody>
            <tr><td>examples/code_embedding/main.py</td><td class="sc-dim ic-n">61</td><td class="sc-dim ic-n">88</td><td class="sc-dim ic-v sc-hide-narrow">[ … ]</td></tr>
            <tr class="sc-delta"><td>examples/code_embedding/main.py</td><td class="ic-n"><span class="sc-dtext">91</span></td><td class="ic-n"><span class="sc-dtext">106</span></td><td class="ic-v sc-hide-narrow"><span class="sc-dtext">[ … ]</span></td></tr>
            <tr><td>rust/ops_text/src/split/recursive.rs</td><td class="sc-dim ic-n">29</td><td class="sc-dim ic-n">52</td><td class="sc-dim ic-v sc-hide-narrow">[ … ]</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="ic-search">
      <span class="sc-cap">Ask it in English</span>
      <div class="sc-query"><span class="sc-ico i-search"></span><span>python main.py "where do we embed chunks?"</span></div>
      <div class="sc-panel"><div class="sc-panel-b ic-hit">
        <span class="ic-src">examples/code_embedding/main.py <span class="sc-dim">(L61-L88)</span></span>
        <div class="ic-code ic-snip">
          <div class="ic-ln"><i>71</i><code><span class="f">@coco.fn</span></code></div>
          <div class="ic-ln"><i>72</i><code><span class="k">async def</span> <span class="f">process_chunk</span>(</code></div>
          <div class="ic-ln ic-gap"><i></i><code>⋯</code></div>
          <div class="ic-ln"><i>78</i><code>    embedding = <span class="k">await</span> coco.use_context(EMBEDDER).<b>embed(chunk.text)</b></code></div>
        </div>
      </div></div>
    </div>
  </div>
) : (
  <div class="ic-card">
    <div class="sc-row sc-keep">
      <div class="sc-panel ic-card-code">
        <div class="sc-panel-h"><span class="sc-ico i-code"></span>main.py</div>
        <div class="ic-code">
          <div class="ic-chunk">
            <div class="ic-ln"><i>71</i><code><span class="f">@coco.fn</span></code></div>
            <div class="ic-ln"><i>72</i><code><span class="k">async def</span> <span class="f">process_chunk</span>(</code></div>
          </div>
          <div class="ic-chunk is-delta">
            <div class="ic-ln"><i>91</i><code><span class="f">@coco.fn</span>(memo=<span class="n">True</span>)</code></div>
            <div class="ic-ln"><i>92</i><code><span class="k">async def</span> <span class="f">process_file</span>(</code></div>
          </div>
        </div>
      </div>
      <span class="sc-to"></span>
      <div class="sc-col ic-card-q">
        <div class="sc-query"><span class="sc-ico i-search"></span><span>"where do we embed chunks?"</span></div>
        <div class="sc-panel"><div class="sc-panel-b">
          <span class="sc-li"><span>main.py</span><span class="sc-meta">L61-L88</span></span>
          <code class="ic-card-line">.embed(chunk.text)</code>
        </div></div>
      </div>
    </div>
  </div>
)}

<style>
  .ic { display: flex; flex-direction: column; gap: 18px; }
  .ic-top { gap: 10px; }
  .ic-repo { flex: 0.8 1 0; }
  .ic-split { flex: 1.35 1 0; }
  .ic .sc-li { font-size: 12px; }
  .ic-tree { gap: 1px; }
  .ic-dir { color: var(--sc-muted); }
  .ic-in { margin-left: 10px; }
  .ic-fine { font-weight: 400; }
  .ic-lang { margin-left: auto; padding-left: 8px; font-family: var(--sans); font-size: 11.5px; color: var(--sc-dim); }

  /* the file as code, with each Tree-sitter chunk boxed */
  .ic-code { padding: 8px 10px 8px 6px; display: flex; flex-direction: column; gap: 6px; background: #0A0A0A; font-family: var(--mono); font-size: 12px; line-height: 1.6; }
  .ic-chunk { position: relative; padding: 3px 6px 3px 2px; background: #161616; }
  .ic-chunk.is-delta { background: var(--sc-delta-bg); }
  .ic-tag { position: absolute; top: 3px; right: 4px; font-size: 11px; color: var(--sc-dim); background: #0A0A0A; padding: 0 4px; border-radius: 4px; }
  .ic-chunk.is-delta .ic-tag { color: var(--sc-delta-text); background: transparent; }
  .ic-ln { display: flex; gap: 10px; min-width: 0; color: var(--sc-ink); }
  .ic-ln i { flex: none; width: 22px; text-align: right; font-style: normal; color: var(--sc-dim); }
  .ic-ln code { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: pre; font: inherit; color: inherit; background: none; border: 0; padding: 0; border-radius: 0; }
  .ic-gap code { color: var(--sc-dim); }
  .ic-code .k { color: #8E96FF; } .ic-code .f { color: #79C0FF; } .ic-code .n { color: #F9C78B; }
  .ic .ic-chunk > .ic-ln:first-of-type code { padding-right: 64px; }

  .ic-n { width: 84px; text-align: right; }
  .ic-v { width: 96px; }
  .ic-search { display: flex; flex-direction: column; gap: 8px; padding-top: 16px; border-top: 1px solid var(--sc-line); }
  .ic-hit { gap: 6px; }
  .ic-src { font-family: var(--mono); font-size: 12px; color: var(--sc-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ic-snip { border: 1px solid var(--sc-line); border-radius: 6px; }
  .ic-snip b { font-weight: 400; color: var(--sc-ink); text-decoration: underline; text-decoration-color: var(--sc-line-2); text-underline-offset: 3px; }

  .ic-card { height: 100%; display: flex; align-items: center; }
  /* long code lines must not widen the catalog grid: size columns by flex, not content */
  .ic-code, .ic-card .sc-query, .ic-card .sc-panel { contain: inline-size; }
  .ic-card > .sc-row { width: 100%; }
  .ic-card-code { flex: 0.85 1 0; }
  .ic-card-q { flex: 1.15 1 0; }
  .ic-card .ic-code { font-size: 11px; padding: 6px 8px 6px 4px; gap: 4px; line-height: 1.5; }
  .ic-card .ic-ln { gap: 6px; }
  .ic-card .ic-ln i { width: 16px; }
  .ic-card-line { background: none; border: 0; padding: 0; font-family: var(--mono); font-size: 11px; color: var(--sc-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @container (max-width: 560px) {
    .ic-n { width: 62px; }
    .ic-tbl-h .ic-lang { display: none; }
  }
</style>
