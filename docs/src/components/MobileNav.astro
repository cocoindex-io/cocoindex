---
import Sidebar from './Sidebar.astro';
import { SITE_MAIN, SITE_BLOG } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentSlug = Astro.url.pathname.slice(base.length).replace(/^\/|\/$/g, '');
---
<details class="mobile-nav">
  <summary>Menu and search</summary>
  <div class="mobile-nav-panel">
    <nav aria-label="Site navigation">
      <a href={`${SITE_MAIN}/cocoindex-code`}>CocoIndex Code</a>
      <a href={`${base}/examples/`}>Examples</a>
      <a href="/docs/">Current documentation</a>
      <a href={`${SITE_MAIN}/enterprise`}>Enterprise</a>
      <a href={SITE_BLOG}>Blog</a>
    </nav>
    <Sidebar currentSlug={currentSlug} mobile />
  </div>
</details>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach(menu => {
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || !menu.open || menu.closest('[inert]')) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.closest('#docsSearchHost, .DocSearch-Container')) return;
      if (menu.open && !menu.closest('[inert]') && !menu.contains(event.target as Node)) menu.open = false;
    });
  });
</script>
<style>
  .mobile-nav { display: none; }
  @media (max-width: 820px) {
    .mobile-nav { display: block; }
    :global(.nav-in) { padding: 12px 16px; gap: 12px; }
    :global(.nav-cta > .stars) { display: none; }
    summary {
      min-height: 44px; display: flex; align-items: center; padding: 8px 10px;
      color: var(--cream); background: var(--maroon); border-radius: 8px;
      font: 500 12px var(--sans); cursor: pointer; list-style: none;
    }
    summary::-webkit-details-marker { display: none; }
    summary:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
    .mobile-nav-panel {
      position: absolute; top: calc(100% + 8px); left: 12px; right: 12px;
      max-height: calc(100dvh - 88px); overflow-y: auto;
      padding: 16px; border: 1px solid var(--rule); border-radius: 12px;
      background: var(--paper); color: var(--maroon-ink);
      box-shadow: 0 10px 30px #0003;
    }
    nav { display: grid; gap: 4px; padding-bottom: 16px; border-bottom: 1px solid var(--rule); }
    nav a { display: block; padding: 10px; color: var(--maroon-ink); font-size: 14px; }
    .mobile-nav :global(aside.mobile-side) {
      display: block; position: static; width: auto; max-height: none; height: auto;
      padding: 0; border: 0; overflow: visible;
    }
    .mobile-nav :global(.search-wrap) { position: static; padding-top: 16px; }
    .mobile-nav :global(.side-group li a) { padding-block: 10px; }
  }
</style>
